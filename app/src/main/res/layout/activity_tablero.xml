<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_categoria"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/fondo_juego_3"
    tools:context="antonio.femxa.appfinal.TableroActivity">
        <ImageButton
        android:layout_gravity="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btnImagen"
        android:src="@drawable/ic_volume_up"/>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:id="@+id/imagenes_ahorcado"
        android:paddingTop="10dp"
        />

    <TableLayout
        android:id="@+id/activity_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <TextView
            android:id="@+id/textviewcategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/boton_victoria_inicio"
            android:layout_alignLeft="@+id/text_palabra_victoria"
            android:layout_alignStart="@+id/text_palabra_victoria"

            android:fontFamily="monospace"
            android:text="category"
            android:textAlignment="center"
            android:textAllCaps="true"
            android:textAppearance="@android:style/TextAppearance"
            android:textColor="@android:color/holo_green_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TableRow
            android:id="@+id/lugar_inflado"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center_vertical"></TableRow>

        <TableRow
            android:id="@+id/lugar_inflado2"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center_vertical"></TableRow>

        <TableRow
            android:id="@+id/lugar_inflado3"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center_vertical"></TableRow>

        <TableRow
            android:id="@+id/lugar_inflado4"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center_vertical"></TableRow>

    </TableLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:text="A"
                    android:gravity="center"
                    android:tag="0" />

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-condensed"
                    android:text="B"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:tag="1" />

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="C"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:tag="2"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="3"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:text="D" />

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="E"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:tag="4"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="F"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:tag="5"/>
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="G"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:tag="6"/>
                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:text="H"
                    android:tag="7"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="I"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="8"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="J"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="9"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="K"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="10"/>
                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="L"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="11"/>

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="M"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="12"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="N"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="13"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Ñ"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="14"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="O"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="15"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="P"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="16"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Q"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="17"/>

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="R"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="18"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="S"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="19"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="T"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="20"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-condensed"
                    android:text="U"
                    android:textSize="11sp"
                    android:tag="21"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="V"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="22"/>

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="W"
                    android:tag="23"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="X"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="24"/>
                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Y"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="25"/>

                <Button
                    android:onClick="escribirNumero"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Z"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:tag="26"/>
            </TableRow>
        </TableLayout>
    </LinearLayout>
</LinearLayout>